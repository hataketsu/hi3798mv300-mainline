// SPDX-License-Identifier: GPL-2.0
/*
 * DTS for an unbranded Hi3798MV300 set-top box.
 *
 * The vendor device tree carries no board name -- its model is the bare string
 * "Hisilicon" and its compatible is "hi3798mv200-series" -- so the board name
 * here is provisional and describes the SoC rather than the product.
 *
 * Released under the GPLv2 only.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>

#include "hi3798mv200.dtsi"

/ {
	model = "Hi3798MV300 TV box";
	compatible = "hisilicon,hi3798mv300-tvbox", "hisilicon,hi3798mv200";

	aliases {
		serial0 = &uart0;
		mmc0 = &emmc;
		mmc1 = &sd0;
		ethernet0 = &femac;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/*
	 * 1 GiB. The stock bootloader's `getinfo ddrfree` reports free DDR as
	 * 0x1000000..0x40000000, and TF-A is built POPLAR_DRAM_SIZE=one_gig to
	 * match. The HC2910 DTS declares 0x80000000; carrying that over here
	 * would map half a gigabyte that does not exist.
	 */
	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x40000000>;
	};

	/*
	 * The two front-panel LEDs, both on gpio5 -- the PL061 at 0xf8004000,
	 * which sits in the always-on block next to sysctrl rather than with
	 * gpio0-gpio9 at 0xf8b2xxxx. That placement is the point: the indicator
	 * has to stay lit in standby, when the main peripheral domain is down.
	 *
	 * Both are active high, and neither is discoverable from software alone.
	 * Reading GPIODIR/GPIODATA across all ten PL061 banks on a running
	 * kernel showed gpio5 as the only bank with outputs configured (line 0
	 * low, line 1 high), which found red on line 0 but nothing else: the
	 * bootloader leaves the blue LED's pin an *input*, so it never lights
	 * under mainline and never shows up in a register scan. It turned up
	 * only by driving each remaining line in turn and watching the box.
	 *
	 * Line 1 is deliberately left unassigned. It is an output the bootloader
	 * leaves high, but it lights nothing, and until what it does is known it
	 * must not be handed to a driver -- least of all one that would blink it.
	 *
	 * The vendor stack is no help: /vendor/bin/gpio-led only calls
	 * HI_UNF_GPIO_Init(), polls the service.bootanim.exit property and calls
	 * HI_UNF_GPIO_DeInit(). The pin numbers live inside the closed
	 * HI_UNF_GPIO library and the vendor device tree has no LED node at all.
	 */
	leds {
		compatible = "gpio-leds";

		led-0 {
			gpios = <&gpio5 0 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_ACTIVITY;
			/*
			 * eMMC activity. mmc0 is f9830000.mmc, the eMMC -- mmc1 is
			 * the empty SD slot and mmc2 the SDIO Wi-Fi. The "cpu"
			 * trigger was useless here: the box is rarely idle enough
			 * for it to blink, so the LED just stayed on.
			 */
			linux,default-trigger = "mmc0";
		};

		led-1 {
			gpios = <&gpio5 2 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_POWER;
			/*
			 * The stock firmware turns this on solid once Android has
			 * booted. A heartbeat says more -- it distinguishes a live
			 * kernel from a hung one -- and any other trigger is one
			 * write to /sys/class/leds/blue:power/trigger away.
			 */
			linux,default-trigger = "heartbeat";
		};
	};

	reserved-memory {
		/*
		 * BL31 stays resident after hand-off and must not be handed to
		 * the page allocator. Its address follows from the l-loader
		 * link base this port uses:
		 *
		 *   LLOADER_TEXT_BASE 0x02000000
		 *   BL1_BASE          0x0200f000   (matches the boot log,
		 *                                  "CPU0 executes at 0x0200f000")
		 *   BL2_BASE          0x0201f000   (+ BL1_SIZE  0x10000)
		 *   BL31_BASE         0x0202c000   (+ BL2_SIZE  0xd000)
		 *   BL31_LIMIT        0x0203f000   (+ BL31_SIZE 0x13000)
		 *
		 * 0x02000000 + 256 KiB covers the whole staging area in one
		 * aligned block. The sml@c00000 reservation inherited from the
		 * dtsi describes the *default* TF-A layout, which this port
		 * does not use -- 0x00C00000 is where the stock bootloader is
		 * linked, so l-loader was moved off it.
		 */
		bl31@2000000 {
			reg = <0x0 0x02000000 0x0 0x00040000>;
			no-map;
		};
	};
};

&uart0 {
	status = "okay";
};

/*
 * Both MMC nodes carry a "default" pinctrl state, and mainline has no pinctrl
 * driver for this SoC yet -- drivers/pinctrl/ contains no HiSilicon STB driver
 * at all, and Yang Xiwen's b4/pinctrl branch has not been rebased forward.
 *
 * A pinctrl state that no provider can supply makes pinctrl_bind_pins() return
 * -EPROBE_DEFER, so the device defers forever. Deferred probe is silent, so the
 * controller simply never appears and the boot stops at "Waiting for root
 * device" with nothing else logged.
 *
 * Dropping the states is safe during bring-up because the stock bootloader has
 * already muxed these pins -- it boots Android off the same eMMC. Restore them
 * once a pinctrl driver exists, or the mux will be wrong on any boot path that
 * does not go through the vendor bootloader first.
 */
&emmc {
	/delete-property/ pinctrl-0;
	/delete-property/ pinctrl-names;

	fifo-depth = <256>;
	clock-frequency = <50000000>;
	max-frequency = <150000000>;
	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	non-removable;
	status = "okay";
};

&sd0 {
	/delete-property/ pinctrl-0;
	/delete-property/ pinctrl-names;

	fifo-depth = <256>;
	clock-frequency = <150000000>;
	bus-width = <4>;
	cap-sd-highspeed;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	sd-uhs-ddr50;
	status = "okay";
};

/*
 * SDIO, which is where the Wi-Fi lives -- an RTL8822BS, handled by rtw88.
 *
 * The vendor DTS calls this controller `himciv200.SD@f9c40000` and gives it
 * caps 0x8007000f: 4-bit data, high speed, SDIO interrupts and the SDR modes.
 * Notably it declares no power-enable GPIO, unlike most Realtek SDIO parts, so
 * no mmc-pwrseq is needed here -- which is just as well, because the GPIO banks
 * still do not probe.
 *
 * `broken-cd` plus `non-removable` because there is no card detect line: the
 * chip is soldered down.
 *
 * rtw88 is built as a module on purpose. It requests firmware during probe,
 * and the SDIO card is found about a second into boot, long before the root
 * filesystem exists -- built in, it would fail before /lib/firmware is there
 * to read.
 */
&sd1 {
	/*
	 * The dtsi spells this node's compatible "hi3798mv200,dw-mshc", while
	 * the two other controllers -- and the driver's match table -- use
	 * "hisilicon,hi3798mv200-dw-mshc". Vendor and family are transposed, so
	 * nothing matches and the controller is simply never probed: no mmc2,
	 * no dmesg line, and nothing in devices_deferred either, because a
	 * device with no driver is not deferred, it is ignored.
	 */
	compatible = "hisilicon,hi3798mv200-dw-mshc";

	/delete-property/ pinctrl-0;
	/delete-property/ pinctrl-names;

	bus-width = <4>;
	max-frequency = <50000000>;
	cap-sd-highspeed;
	cap-sdio-irq;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	non-removable;
	broken-cd;
	status = "okay";
};

/*
 * The FE PHY keeps the dtsi's MDIO address 1. The stock environment reads
 * phy_addr=2,1 and the stock bootloader prints "Eth up port phy at 0x02 is
 * connect", but the address it actually programs into perictrl 0xf8a20118[4:0]
 * is 1 -- read back from a running kernel as 0x03000001. Address 2 gives an
 * MDIO bus that answers 0x00000000 to every read.
 */
&femac {
	status = "okay";
};

/*
 * IR receiver. No linux,rc-map-name on purpose -- the remote this box shipped
 * with has not been identified, so the driver falls back to RC_MAP_EMPTY and
 * every scancode arrives undecorated. Read raw pulses from /dev/lirc0 or
 * scancodes with `ir-keytable -t`, then pick a keymap once one matches.
 */
&ir {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&gpio3 {
	status = "okay";
};

&gpio4 {
	status = "okay";
};

/*
 * gpio5 drives the front-panel LEDs. It is also the one PL061 on this SoC
 * with no gpio-ranges, so unlike gpio0-gpio9 it probes without a pinctrl
 * driver -- and hisilicon,hi3798mv200-ioconfig has none in mainline.
 */
&gpio5 {
	status = "okay";
};

&gpio6 {
	status = "okay";
};

&gpio7 {
	status = "okay";
};

&gpio8 {
	status = "okay";
};

&gpio9 {
	status = "okay";
};

&wdg0 {
	status = "okay";
};

/*
 * USB2 PHY.
 *
 * This one had to be reverse engineered out of the stock bootloader, because
 * neither the vendor device tree nor the dtsi describes it usably.
 *
 * The vendor DTS has no PHY node at all -- its `hiusbotg` node just maps OHCI,
 * EHCI and a lone word at 0xf8a2012c, and the BSP does PHY setup in C. The
 * dtsi, meanwhile, puts the PHY under a `usb2phy-test-bus` node with no `reg`
 * of its own, expecting a bus driver that exists in no tree, so the upstream
 * driver fails on its own ioremap:
 *
 *   hisi-inno-phy f9865000.usb-phy-bus:usb-phy: error -EINVAL: invalid resource
 *
 * Guessing 0xf8a2012c from the OTG node was wrong. The driver bound and both
 * host controllers registered, but every port then timed out:
 *
 *   ehci-platform f9890000.usb: port 2 reset error -110
 *
 * The stock bootloader has the answer. In the fastboot image its USB2 init
 * routine selects a base by chip ID:
 *
 *   ldr r2, [pc, #236]   ; 0x37980210   <- this chip
 *   cmpeq r0, r2
 *   bne   <other model>
 *   ldr r4, [pc, #212]   ; 0xf9865fff
 *
 * and then writes through r4 with negative offsets:
 *
 *   str r3, [r4, #-4095] -> 0xf9865000   reg 0x00 = 0x18
 *   str r3, [r4, #-3071] -> 0xf9865400   reg 0x00 = 0x18
 *   str r3, [r4, #-4079] -> 0xf9865010   reg 0x04 = 0xd7
 *   str r3, [r4, #-3979] -> 0xf9865074   reg 0x1d = 0x1e
 *   str r3, [r4, #-3971] -> 0xf986507c   reg 0x1f = 0x6e
 *
 * So this SoC does not use the hi3798cv200 test-port protocol, where one word
 * is bit-banged with address, data and a clock bit. Its PHY registers are
 * mapped directly: a 4 KiB window at 0xf9865000, one 32-bit word per 8-bit
 * register, and port 1 a further 0x400 along. That is exactly what the
 * Hi3798MV200 support patch in patches/kernel/ implements -- it ioremaps each
 * port child and writes `base + addr * 4`.
 *
 * The routine finishes by clearing bits 8 and 9 of CRG 0xbc, which confirms the
 * per-port resets below are the right ones.
 *
 * The extra `<&crg 0xbc 15>` is the reset the dtsi hangs on the test-bus node.
 * Nothing drives that bus here, so the PHY has to release it itself, which is
 * why the driver moved to reset_control_array. The bus's APB clock is left as
 * the bootloader set it, on the same reasoning as the MMC pinctrl above.
 *
 * USB3 (xhci/dwc3/combphy) is still off -- one thing at a time.
 */
&soc {
	tvbox_usb2_phy: usb2-phy@9865000 {
		compatible = "hisilicon,hi3798mv200-usb2-phy";
		reg = <0x9865000 0x1000>;
		clocks = <&crg HI3798MV200_USB2_PHY2_REF_CLK>;
		resets = <&crg 0xbc 4>, <&crg 0xbc 15>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x9865000 0x1000>;

		tvbox_usb2_port0: phy@0 {
			reg = <0x0 0x400>;
			resets = <&crg 0xbc 8>;
			#phy-cells = <0>;
		};

		tvbox_usb2_port1: phy@400 {
			reg = <0x400 0x400>;
			resets = <&crg 0xbc 9>;
			#phy-cells = <0>;
		};
	};
};

&ehci {
	phys = <&tvbox_usb2_port0>, <&tvbox_usb2_port1>;
	status = "okay";
};

&ohci {
	phys = <&tvbox_usb2_port0>, <&tvbox_usb2_port1>;
	status = "okay";
};
