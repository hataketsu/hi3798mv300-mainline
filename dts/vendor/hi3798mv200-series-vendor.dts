		hiddr_watchpoint@F8A36000 {
			compatible = "hisilicon.ddr_watchpoint";
			reg = <0xf8a36000 0x1000>;
			interrupts = <0x00 0x1f 0x04>;
			phandle = <0x33>;
		};

		hiddr_watchzone@F8A35000 {
			compatible = "hisilicon.ddr_watchzone";
			reg = <0xf8a35000 0x1000>;
			interrupts = <0x00 0x1f 0x04>;
			phandle = <0x34>;
		};

		regulator@f8a23020 {
			compatible = "hisilicon,hi3798mv200-volt";
			reg = <0xf8a23020 0x04>;
			reg-names = "Hisilicon GPU Regulator";
			regulator-name = "vdd-gpu";
			regulator-min-microvolt = <0xaae60>;
			regulator-max-microvolt = <0x1312d0>;
			regulator-always-on;
			status = "okay";
			phandle = <0x0f>;
		};

		gpu@f9200000 {
			compatible = "arm,mali-450\0arm,mali-utgard";
			interrupt-parent = <0x01>;
